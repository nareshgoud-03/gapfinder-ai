# GapFinder AI Environment Variables

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Groq API (Get free key at https://console.groq.com)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Hugging Face Embeddings (Optional, defaults to sentence-transformers/all-MiniLM-L6-v2)
HUGGINGFACE_API_KEY=hf_your_huggingface_api_key_here
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Supabase (Optional for local/demo mode, required for cloud production)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
